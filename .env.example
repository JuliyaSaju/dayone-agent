# ---- Which AI model drives the agent: mock | anthropic | openai ----
# "mock" needs no key and gives fixed answers (good for tests and first runs).
LLM_PROVIDER=mock

# If LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# If LLM_PROVIDER=openai  (works with OpenAI, and with any OpenAI-compatible
# service such as Gemini's compatibility endpoint or a local Ollama server)
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# ---- The two apps (run locally with Docker) ----
MM_URL=http://localhost:8065
MM_ADMIN_EMAIL=admin@example.test
MM_ADMIN_PASSWORD=Admin-Pass-12345!
MM_TEAM=acme

GITEA_URL=http://localhost:3000
GITEA_TOKEN=
GITEA_OWNER=dayone-admin

# Synthetic password given to every demo account (never use a real one)
DEMO_USER_PASSWORD=Welcome-Pass-2026!x

# Optional: inject failures on purpose, e.g. mm_create_user=fail_after_once
FAULTS=
